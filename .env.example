# ==============================================================================
# SMART FARMER CONNECT - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
# Windows (PowerShell): Copy-Item .env.example .env.local
# Mac/Linux:           cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (safe to expose to browser for public reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CRITICAL SECURITY: Server-Side Service Role Key
# NEVER expose this to the browser or commit to Git.
# Used ONLY in Next.js Server Components / API routes to run admin queries.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION & DEMO MODE
# ------------------------------------------------------------------------------
# Set to 'development' for local work, or 'production' when deployed.
NODE_ENV=development

# Base URL for metadata and redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fixed development OTP for quick testing without waiting for real SMS
# In demo mode, entering this OTP will always log in any registered user.
DEV_OTP_CODE=123456

# ------------------------------------------------------------------------------
# 3. NOTIFICATION ADAPTERS & MOCK MODES
# ------------------------------------------------------------------------------
# When true, the application logs SMS messages to the console and marks them
# as 'mock' in the database. The UI honestly informs the user:
# "Demo mode: no real SMS sent".
MOCK_SMS_MODE=true
# Provider options: 'mock' | 'msg91' | 'twilio'
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API (set to true to use mock mode with honest UI notices)
MOCK_WHATSAPP_MODE=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Web Push Notifications (VAPID)
MOCK_PUSH_MODE=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartfarmerconnect.in

# ------------------------------------------------------------------------------
# 4. EXTERNAL INTEGRATIONS (FEATURE FLAGS)
# ------------------------------------------------------------------------------
# Government of India Mandi Prices (data.gov.in Agmarknet API)
# If true, uses pre-cached mandi rates for Karnataka APMCs.
MOCK_AGMARKNET_MODE=true
DATA_GOV_IN_API_KEY=

# Open-Meteo Weather API (free, does not strictly require a key)
MOCK_WEATHER_MODE=true

# AI Crop Photo & Quality Advisory (Anthropic Claude API)
# Server-side only! Never exposed to the browser.
MOCK_AI_MODE=true
ANTHROPIC_API_KEY=
